# API 서버 설정 (없으면 아래 기본값을 쓴다)
PORT=4000
# 개발용 DB (pnpm db:start). 다른 DB를 쓰려면 바꾼다
DATABASE_URL=postgres://yconic:yconic@localhost:5433/yconic
# 이 주소의 웹앱만 API를 부를 수 있다 (여러 개면 쉼표로)
WEB_ORIGIN=http://localhost:3000
# 영상 재생 주소를 만들 때 쓰는 이 서버의 바깥 주소
API_PUBLIC_URL=http://localhost:4000
# 올린 영상 파일을 두는 폴더 (기본: apps/api/storage)
# STORAGE_DIR=
# 구글 로그인 (docs/decisions/0016). Google Cloud Console에서 만든 OAuth 클라이언트 ID(웹). 비우면 구글 로그인 버튼이 나오지 않는다
# GOOGLE_CLIENT_ID=
# 구글로 로그인하면 최고 관리자가 되는 이메일 (쉼표로 여러 개). 저장소가 공개라 실제 주소는 서버의 .env에만 적는다
# SUPER_ADMIN_EMAILS=
# 이메일 가입을 막으려면 off. 한 곳(IP)에서 한 시간에 받는 가입 수와 하루 전체 가입 수
# SIGNUP=off
# SIGNUP_PER_IP_PER_HOUR=10
# SIGNUP_PER_DAY=300
# 로그인 화면에서 체험 계정을 숨기려면 off (공개 서버에서는 끄고, 체험 계정의 비밀번호도 바꾼다)
# DEMO_ACCOUNTS=off
# 영상을 나눠 올릴 때 조각 하나의 크기 (바이트, 기본 786432 = 768KB). 서버 앞 프록시가 받는 크기보다 작아야 한다
# UPLOAD_CHUNK_BYTES=786432
# 모의 AI 작업 한 단계 / 모의 음성 생성에 걸리는 시간 (밀리초)
JOB_STAGE_MS=2500
TTS_MS=3000
# Claude API 키. 있으면 실제 영상 분석기와 AI 맞춤 안내를 쓴다 (docs/decisions/0008). 절대 커밋하지 않는다
ANTHROPIC_API_KEY=
# 영상 분석기: claude(키가 있을 때 기본) 또는 mock
VIDEO_ANALYZER=claude
# 장면 추출·받아쓰기 도구 위치 (PATH에 있으면 그대로)
FFMPEG=ffmpeg
PYTHON=python
# 하루 AI 사용 한도 (공개 링크로 열어 둘 때. 비우면 제한 없음). 넘으면 영상 분석은 실패로 알리고, 맞춤 안내는 규칙으로 고른다
# AI_DAILY_LIMIT_ANALYSIS=5
# AI_DAILY_LIMIT_GUIDES=100
# 공개 링크(pnpm share)로 들어와도 관리자 계정 로그인을 허용하려면 allow (기본: 막음).
# 저장소가 공개라 예시 관리자 비밀번호도 공개되어 있다. 시연할 때만 잠깐 켠다
# PUBLIC_LINK_ADMIN_LOGIN=allow
# 영상 재생 주소의 앞부분 (기본 /api: 웹앱이 API를 대신 연결하므로 어느 주소로 열어도 영상이 나온다)
# API_PUBLIC_URL=/api
# faster-whisper 모델 (small: 한국어 정확도와 속도 균형, medium: 더 정확하지만 느림)
WHISPER_MODEL=small
