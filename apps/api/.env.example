# API 서버 설정 (없으면 아래 기본값을 쓴다)
PORT=4000
# 개발용 DB (pnpm db:start). 다른 DB를 쓰려면 바꾼다
DATABASE_URL=postgres://yconic:yconic@localhost:5433/yconic
# 이 주소의 웹앱만 API를 부를 수 있다 (여러 개면 쉼표로)
WEB_ORIGIN=http://localhost:3000
# 영상 재생 주소를 만들 때 쓰는 이 서버의 바깥 주소
API_PUBLIC_URL=http://localhost:4000
# 올린 영상 파일을 두는 폴더 (기본: apps/api/storage)
# STORAGE_DIR=
# 모의 AI 작업 한 단계 / 모의 음성 생성에 걸리는 시간 (밀리초)
JOB_STAGE_MS=2500
TTS_MS=3000
# Claude API 키. 있으면 실제 영상 분석기와 AI 맞춤 안내를 쓴다 (docs/decisions/0008). 절대 커밋하지 않는다
ANTHROPIC_API_KEY=
# 영상 분석기: claude(키가 있을 때 기본) 또는 mock
VIDEO_ANALYZER=claude
# 장면 추출·받아쓰기 도구 위치 (PATH에 있으면 그대로)
FFMPEG=ffmpeg
PYTHON=python
# faster-whisper 모델 (small: 한국어 정확도와 속도 균형, medium: 더 정확하지만 느림)
WHISPER_MODEL=small
