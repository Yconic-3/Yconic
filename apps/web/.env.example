# 데이터 소스 (사용자 화면과 관리자 화면이 함께 쓴다)
#   http (기본): 백엔드 API(apps/api). pnpm db:start, pnpm dev:api 가 켜져 있어야 한다.
#   mock: 서버 없이 브라우저 저장소의 모의 데이터 (화면만 빨리 볼 때)
NEXT_PUBLIC_API_MODE=http
# 백엔드 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# 사용자 AI 에이전트 주소 (pnpm dev:agent). 꺼져 있거나 API 키가 없으면 음성 명령을 규칙 기반으로 해석한다
NEXT_PUBLIC_AGENT_URL=http://localhost:4100
