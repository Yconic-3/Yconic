# 사용자 AI 에이전트 설정 (없으면 아래 기본값을 쓴다)
AGENT_PORT=4100
# 운동 정보를 가져올 백엔드 API (pnpm dev:api)
API_BASE_URL=http://localhost:4000
# 이 주소의 웹앱만 에이전트를 부를 수 있다 (여러 개면 쉼표로)
WEB_ORIGIN=http://localhost:3000
# Claude API 키. 비워 두면 AI가 꺼지고, 웹앱은 규칙 기반 해석으로 돌아간다. 절대 커밋하지 않는다
ANTHROPIC_API_KEY=
# 쓸 모델과 생각 깊이 (low | medium | high | xhigh | max). 음성 대화라 기본은 빠른 low
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# 한 사람(IP)이 1분에 보낼 수 있는 요청 수
AGENT_RATE_LIMIT=30
