    "dev:admin": "turbo run dev --filter=@yconic/admin-web",
    "dev:user": "turbo run dev --filter=@yconic/user-app"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
